# Copy this file to .env (never commit .env) and fill in the values.

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model used for the assessments (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: where the TCX files and the database live (defaults shown)
# CADENCE_DATA_DIR=~/cadencia-ia/entrada
# CADENCE_DB=~/cadencia-ia/cadence.db
